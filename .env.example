# Copy to .env and fill in. Never commit .env.

# ── Required (the app refuses to start without these) ────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
GROQ_API_KEY=
ADMIN_PASSWORD=

# ── Strongly recommended ─────────────────────────────────────────────────────
# Signs session cookies. If unset, a hardcoded fallback in app/config.py is used.
SECRET_KEY=
# Secret URL segment for the admin panel: /admin/<ADMIN_SLUG>
ADMIN_SLUG=
# Enables owner verification in chat.
OWNER_CODE=
# Security alerts (bans, secret-extraction attempts) are posted here.
DISCORD_WEBHOOK=

# ── Content filtering (comma-separated word lists) ───────────────────────────
ENGLISH_BAD_WORDS=
MALAYALAM_BAD_WORDS=

# ── Chat / vision (extra Groq keys are used as fallbacks) ────────────────────
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ── Image generation ─────────────────────────────────────────────────────────
HF_API_KEY=
HF_API_KEY_2=
HF_API_KEY_3=
HF_API_KEY_4=
TOGETHER_API_KEY=
HORDE_API_KEY=
SILICONFLOW_API_KEY=
NVIDIA_API_KEY_2=

# ── Search ───────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
YOUTUBE_API_KEY=

# ── Website builder models (NVIDIA NIM) ──────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_API_3=
NVIDIA_API_4=
